# Firebase Configuration
# Copy your service account JSON file to the path below
# OR paste the private key content into the FIREBASE_PRIVATE_KEY variable

# Method 1: File-based (Recommended)
FIREBASE_KEY_FILE=${FIREBASE_KEY_FILE:-config/firebase-service-account.json}

# Method 2: Environment variable (if you prefer inline)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=your-key-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"
# FIREBASE_CLIENT_EMAIL=your-email@your-project.iam.gserviceaccount.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
