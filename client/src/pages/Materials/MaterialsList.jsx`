import { useState, useEffect } from 'react';
import { Link, useParams } from 'react-router-dom';
import { materialAPI } from '../../services/api';
import { useAuth } from '../../contexts/AuthContext';
import LoadingSpinner from '../../components/LoadingSpinner';

const MaterialsList = () => {
  const { id: projectId } = useParams();
  const { user } = useAuth();

  const [materials, setMaterials] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [filter, setFilter] = useState('all');
  const [search, setSearch] = useState('');

  useEffect(() => {
    fetchMaterials();
  }, [projectId, filter]);

  const fetchMaterials = async () => {
    try {
      setLoading(true);
      const params = { projectId };
      if (filter !== 'all') params.category = filter;
      if (search) params.search = search;

      const response = await materialAPI.getAll(projectId, params);
      setMaterials(response.data.data);
      setError('');
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to load materials');
    } finally {
      setLoading(false);
    }
  };

  const deleteMaterial = async (id) => {
    if (!window.confirm('Are you sure you want to delete this material?')) return;

    try {
      await materialAPI.delete(id);
      setMaterials(materials.filter(m => m._id !== id));
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to delete material');
    }
  };

  const getStatusColor = (status) => {
    const colors = {
      'ordered': 'bg-gray-100 text-gray-600 border-gray-200',
      'in-transit': 'bg-primary/10 text-primary border-primary/20',
      'delivered': 'bg-green-50 text-green-700 border-green-200',
      'installed': 'bg-purple-50 text-purple-700 border-purple-200',
    };
    return colors[status] || 'bg-gray-100 text-gray-600 border-gray-200';
  };

  const getCategoryColor = (category) => {
    const colors = {
      concrete: 'bg-slate-200 text-slate-600',
      steel: 'bg-slate-400 text-white',
      wood: 'bg-amber-200 text-amber-800',
      electrical: 'bg-yellow-200 text-yellow-800',
      plumbing: 'bg-blue-200 text-blue-800',
      paint: 'bg-pink-200 text-pink-800',
      other: 'bg-gray-200 text-gray-600',
    };
    return colors[category] || 'bg-gray-200 text-gray-600';
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <LoadingSpinner size="large" />
      </div>
    );
  }

  const categories = ['all', 'concrete', 'steel', 'wood', 'electrical', 'plumbing', 'paint', 'other'];
  const totalCost = materials.reduce((sum, m) => sum + (m.totalCost || 0), 0);

  return (
    <div className="max-w-7xl mx-auto px-4 py-12 mt-16">
      {/* Header */}
      <div className="mb-10">
        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <h2 className="text-3xl font-heading font-bold text-slate-900 tracking-tight">Materials Inventory</h2>
            <p className="text-secondary mt-1">Manage project materials and procurement tracking</p>
          </div>
          <div className="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm min-w-[200px] text-right">
            <p className="text-xs font-bold text-secondary uppercase tracking-wider">Total Expenditure</p>
            <p className="text-2xl font-heading font-bold text-cta">${totalCost.toLocaleString()}</p>
          </div>
        </div>
      </div>

      {/* Filters */}
      <div className="bg-white rounded-3xl p-6 mb-10 shadow-sm border border-gray-200 transition-all duration-300">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className="space-y-2">
            <label className="block text-xs font-bold text-secondary uppercase tracking-wider">Category</label>
            <select
              value={filter}
              onChange={(e) => setFilter(e.target.value)}
              className="w-full rounded-xl border-gray-200 px-4 py-2.5 text-textMain focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all cursor-pointer"
            >
              {categories.map(cat => (
                <option key={cat} value={cat}>{cat.charAt(0).toUpperCase() + cat.slice(1)}</option>
              ))}
            </select>
          </div>
          <div className="space-y-2">
            <label className="block text-xs font-bold text-secondary uppercase tracking-wider">Search Inventory</label>
            <input
              type="text"
              placeholder="Search by name, supplier..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              className="w-full rounded-xl border-gray-200 px-4 py-2.5 text-textMain placeholder-gray-400 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
            />
          </div>
          <div className="flex items-end">
            <Link
              to={`/projects/${projectId}/materials/create`}
              className="w-full bg-primary text-white px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-all duration-200 text-center font-semibold shadow-sm cursor-pointer"
            >
              + Add Material
            </Link>
          </div>
        </div>
      </div>

      {/* Error */}
      {error && (
        <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg mb-8 transition-all duration-300">
          {error}
        </div>
      )}

      {/* Materials Grid */}
      {materials.length === 0 ? (
        <div className="text-center py-24 bg-white rounded-3xl border border-dashed border-gray-300">
          <div className="bg-gray-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg className="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 className="text-xl font-heading font-bold text-slate-900">No materials found</h3>
          <p className="text-secondary mt-2 mb-6">Your inventory is currently empty. Start by adding a material.</p>
          <Link
            to={`/projects/${projectId}/materials/create`}
            className="inline-block bg-primary text-white px-6 py-2 rounded-xl hover:bg-primary/90 transition-all duration-200 font-semibold cursor-pointer"
          >
            Add First Material
          </Link>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {materials.map((material) => (
            <div key={material._id} className="group bg-white p-6 rounded-2xl border border-gray-200 shadow-sm transition-all duration-300 hover:border-primary hover:shadow-xl hover:-translate-y-1">
              <div className="flex justify-between items-start mb-6">
                <div className="flex items-center gap-3">
                  <div className={`w-12 h-12 rounded-xl ${getCategoryColor(material.category)} flex items-center justify-center text-white font-bold text-sm shadow-sm`}>
                    {material.category.substring(0, 2).toUpperCase()}
                  </div>
                  <div>
                    <h3 className="font-heading font-bold text-slate-900 group-hover:text-primary transition-colors">
                      {material.name}
                    </h3>
                    <p className="text-xs font-medium text-secondary uppercase tracking-wider">
                      {material.category}
                    </p>
                  </div>
                </div>
                <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${getStatusColor(material.status)}`}>
                  {material.status}
                </span>
              </div>

              <div className="space-y-3 text-sm mb-6">
                <div className="flex justify-between items-center p-2 bg-gray-50 rounded-lg border border-gray-100">
                  <span className="text-secondary">Quantity:</span>
                  <span className="font-semibold text-textMain">{material.quantity} {material.unit}</span>
                </div>
                <div className="flex justify-between items-center p-2 bg-gray-50 rounded-lg border border-gray-100">
                  <span className="text-secondary">Unit Cost:</span>
                  <span className="font-semibold text-textMain">${material.unitCost?.toLocaleString()}</span>
                </div>
                <div className="flex justify-between items-center p-2 bg-primary/5 rounded-lg border border-primary/10">
                  <span className="font-semibold text-primary">Total:</span>
                  <span className="font-heading font-bold text-primary">${material.totalCost?.toLocaleString()}</span>
                </div>
              </div>

              {material.supplier && (
                <div className="mb-6 flex items-center gap-2 text-xs text-secondary">
                  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5" />
                  </svg>
                  <span>Supplier: {material.supplier}</span>
                </div>
              )}

              <div className="pt-4 border-t border-gray-100 flex justify-between items-center">
                <div className="text-[10px] font-medium text-secondary uppercase tracking-wider">
                  {material.orderDate && <span>Ordered: {new Date(material.orderDate).toLocaleDateString()}</span>}
                  {material.expectedDelivery && <span className="ml-3">Expected: {new Date(material.expectedDelivery).toLocaleDateString()}</span>}
                </div>
                <button
                  onClick={() => deleteMaterial(material._id)}
                  className="text-red-400 hover:text-red-600 text-xs font-bold transition-colors duration-200 cursor-pointer"
                >
                  Delete
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

export default MaterialsList;
