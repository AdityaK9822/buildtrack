import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { projectAPI, authAPI } from '../services/api';
import { useAuth } from '../contexts/AuthContext';
import LoadingSpinner from '../components/LoadingSpinner';

const CreateProject = () => {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [formData, setFormData] = useState({
    name: '',
    description: '',
    'location.address': '',
    'location.city': '',
    'location.state': '',
    'budget.estimated': '',
    startDate: '',
    estimatedEndDate: '',
  });

  const [users, setUsers] = useState([]);
  const [loadingUsers, setLoadingUsers] = useState(false);
  const [contractorId, setContractorId] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    if (user?._id) {
      setContractorId(user._id);
    }
  }, [user]);

  const handleChange = (e) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value,
    });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      const projectData = {
        name: formData.name,
        description: formData.description,
        location: {
          address: formData['location.address'],
          city: formData['location.city'],
          state: formData['location.state'],
        },
        budget: {
          estimated: Number(formData['budget.estimated']),
        },
        startDate: formData.startDate,
        estimatedEndDate: formData.estimatedEndDate || undefined,
        clientId: user._id,
        contractorId: contractorId || user._id,
        architectId: formData.architectId || undefined,
      };

      const response = await projectAPI.create(projectData);
      navigate(`/projects/${response.data.data._id}`);
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to create project');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="max-w-3xl mx-auto px-4 py-12 mt-16">
      <button
        onClick={() => navigate('/dashboard')}
        className="mb-8 text-primary hover:text-cta transition-colors duration-200 flex items-center gap-2 font-medium cursor-pointer group"
      >
        <svg className="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Dashboard
      </button>

      <div className="bg-white rounded-3xl border border-gray-200 shadow-sm p-8 md:p-12 transition-all duration-300">
        <div className="mb-10 text-center md:text-left">
          <h1 className="text-4xl font-heading font-bold text-slate-900 tracking-tight">Create New Project</h1>
          <p className="text-secondary mt-2">Define the initial parameters for your construction project.</p>
        </div>

        {error && (
          <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg mb-8 transition-all duration-300">
            {error}
          </div>
        )}

        <form onSubmit={handleSubmit} className="space-y-8">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div className="md:col-span-2">
              <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Project Name *
              </label>
              <input
                type="text"
                name="name"
                required
                className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                placeholder="e.g., Skyline Apartments Complex"
                value={formData.name}
                onChange={handleChange}
              />
            </div>

            <div className="md:col-span-2">
              <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Description
              </label>
              <textarea
                name="description"
                rows="3"
                className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                placeholder="Project scope, key objectives, and general notes..."
                value={formData.description}
                onChange={handleChange}
              />
            </div>
          </div>

          <div className="pt-6 border-t border-gray-100">
            <h3 className="text-lg font-heading font-bold text-slate-900 mb-6 flex items-center gap-2">
              <svg className="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.423C17.657 16.423 17.657 16.423 17.657 16.423" />
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 12a9 9 0 100 0 9 9 0 000 0z" />
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 12v6m0 0l-3-3m3 3l3-3" />
              </svg>
              Location Details
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="md:col-span-2">
                <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">Address</label>
                <input
                  type="text"
                  name="location.address"
                  className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                  placeholder="Street address"
                  value={formData['location.address']}
                  onChange={handleChange}
                />
              </div>
              <div>
                <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">City</label>
                <input
                  type="text"
                  name="location.city"
                  className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                  placeholder="City"
                  value={formData['location.city']}
                  onChange={handleChange}
                />
              </div>
              <div>
                <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">State</label>
                <input
                  type="text"
                  name="location.state"
                  className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                  placeholder="State"
                  value={formData['location.state']}
                  onChange={handleChange}
                />
              </div>
              <div className="md:col-span-2">
                <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                  Estimated Budget ($) *
                </label>
                <input
                  type="number"
                  name="budget.estimated"
                  required
                  min="0"
                  step="100"
                  className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                  placeholder="Enter total estimated budget"
                  value={formData['budget.estimated']}
                  onChange={handleChange}
                />
              </div>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-gray-100">
            <div>
              <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Start Date *
              </label>
              <input
                type="date"
                name="startDate"
                required
                className="w-full border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                value={formData.startDate}
                onChange={handleChange}
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                Estimated End Date
              </label>
              <input
                type="date"
                name="estimatedEndDate"
                className="w-full border border-gray-200 rounded-xl px-4 py-2 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-textMain"
                value={formData.estimatedEndDate}
                onChange={handleChange}
              />
            </div>
          </div>

          <div className="pt-6 border-t border-gray-100">
            <h3 className="text-lg font-heading font-bold text-slate-900 mb-6 flex items-center gap-2">
              <svg className="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M12 7.05v11M16 18l-2-2-2 2" />
              </svg>
              Team Allocation
            </h3>
            <div className="p-4 bg-gray-50 rounded-2xl border border-gray-200">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-4">
                  <div className="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold text-lg">
                    {user?.name?.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <p className="font-heading font-bold text-textMain">{user?.name}</p>
                    <p className="text-xs text-secondary">Principal Contractor</p>
                  </div>
                </div>
                <span className="text-[10px] font-bold uppercase px-2 py-1 rounded bg-primary/20 text-primary border border-primary/30">
                  Automatic
                </span>
              </div>
            </div>
            <p className="text-xs text-secondary mt-3 text-center italic">
              You are automatically assigned as the lead contractor for this project.
            </p>
          </div>

          <div className="flex gap-4 pt-8">
            <button
              type="button"
              onClick={() => navigate('/dashboard')}
              className="flex-1 bg-white border border-gray-200 hover:border-primary text-textMain py-3 px-4 rounded-xl font-semibold transition-all duration-200 cursor-pointer hover:bg-primary/5"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={loading}
              className="flex-1 bg-cta hover:bg-orange-600 text-white py-3 px-4 rounded-xl font-semibold transition-all duration-200 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            >
              {loading ? <LoadingSpinner size="small" /> : 'Confirm & Create Project'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default CreateProject;
