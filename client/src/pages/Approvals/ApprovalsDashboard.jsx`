import { useState, useEffect } from 'react';
import { approvalAPI } from '../../services/api';
import { useAuth } from '../../contexts/AuthContext';
import LoadingSpinner from '../../components/LoadingSpinner';

const ApprovalsDashboard = () => {
  const { user } = useAuth();

  const [approvals, setApprovals] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [activeTab, setActiveTab] = useState('pending');
  const [selectedApproval, setSelectedApproval] = useState(null);
  const [comment, setComment] = useState('');

  useEffect(() => {
    fetchApprovals();
  }, []);

  const fetchApprovals = async () => {
    try {
      setLoading(true);
      const response = await approvalAPI.getPending();
      setApprovals(response.data.data);
      setError('');
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to load approvals');
    } finally {
      setLoading(false);
    }
  };

  const handleApprove = async (approvalId, status) => {
    try {
      await approvalAPI.approve({
        approvalId,
        status,
        comments: comment,
        approverId: user._id,
      });

      setApprovals(approvals.filter(a => a._id !== approvalId));
      setComment('');
      setSelectedApproval(null);
    } catch (err) {
      setError(err.response?.data?.message || 'Failed to process approval');
    }
  };

  if (user && user.role !== 'architect' && user.role !== 'admin') {
    return (
      <div className="max-w-3xl mx-auto px-4 py-16 text-center mt-16">
        <div className="text-gray-400 mb-4">
          <svg className="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 className="text-xl font-heading font-bold text-slate-900">Access Restricted</h2>
        <p className="text-secondary mt-2">This page is only accessible to Architects and Admins</p>
      </div>
    );
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <LoadingSpinner size="large" />
      </div>
    );
  }

  const pendingCount = approvals.filter(a => !a.status).length;
  const approvedCount = approvals.filter(a => a.status === 'approved').length;
  const rejectedCount = approvals.filter(a => a.status === 'rejected').length;

  return (
    <div className="max-w-7xl mx-auto px-4 py-12 mt-16">
      {/* Header */}
      <div className="mb-10">
        <h2 className="text-3xl font-heading font-bold text-slate-900 tracking-tight">Approvals Dashboard</h2>
        <p className="text-secondary mt-1">Manage milestone approvals and project requests</p>
      </div>

      {/* Stats Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 transition-all hover:shadow-md">
          <p className="text-xs font-bold text-secondary uppercase tracking-wider">Pending</p>
          <p className="text-3xl font-heading font-bold text-yellow-600">{pendingCount}</p>
        </div>
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 transition-all hover:shadow-md">
          <p className="text-xs font-bold text-secondary uppercase tracking-wider">Approved</p>
          <p className="text-3xl font-heading font-bold text-green-600">{approvedCount}</p>
        </div>
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 transition-all hover:shadow-md">
          <p className="text-xs font-bold text-secondary uppercase tracking-wider">Rejected</p>
          <p className="text-3xl font-heading font-bold text-red-600">{rejectedCount}</p>
        </div>
      </div>

      {/* Error */}
      {error && (
        <div className="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg mb-8 transition-all duration-300">
          {error}
        </div>
      )}

      {/* Tabs */}
      <div className="flex space-x-3 mb-8">
        <button
          onClick={() => setActiveTab('pending')}
          className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer ${
            activeTab === 'pending'
              ? 'bg-primary text-white shadow-sm'
              : 'text-textMain hover:bg-primary/10 hover:text-primary'
          }`}
        >
          Pending ({pendingCount})
        </button>
        <button
          onClick={() => setActiveTab('approved')}
          className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer ${
            activeTab === 'approved'
              ? 'bg-green-100 text-green-800 border border-green-200'
              : 'text-textMain hover:bg-primary/10 hover:text-primary'
          }`}
        >
          Approved ({approvedCount})
        </button>
        <button
          onClick={() => setActiveTab('rejected')}
          className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer ${
            activeTab === 'rejected'
              ? 'bg-red-100 text-red-800 border border-red-200'
              : 'text-textMain hover:bg-primary/10 hover:text-primary'
          }`}
        >
          Rejected ({rejectedCount})
        </button>
      </div>

      {/* Approvals List */}
      {approvals.length === 0 && activeTab === 'pending' ? (
        <div className="text-center py-24 bg-white rounded-3xl border border-dashed border-gray-300">
          <div className="bg-gray-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg className="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 className="text-xl font-heading font-bold text-slate-900">No Pending Approvals</h3>
          <p className="text-secondary mt-2">All caught up! No project requests require your attention.</p>
        </div>
      ) : (
        <div className="space-y-6">
          {approvals.map((approval) => (
            <div key={approval._id} className="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm transition-all duration-300 hover:border-primary hover:shadow-md">
              <div className="flex justify-between items-start mb-6">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
                    📋
                  </div>
                  <div>
                    <h3 className="font-heading font-bold text-slate-900 text-lg">{approval.milestoneName}</h3>
                    <div className="flex items-center gap-2 mt-1">
                      <p className="text-xs text-secondary">Submitted by: {approval.submittedByName}</p>
                      <span className="text-gray-300">•</span>
                      <p className="text-xs text-secondary">
                        {approval.submittedAt && `On: ${new Date(approval.submittedAt).toLocaleDateString()}`}
                      </p>
                    </div>
                  </div>
                </div>
                <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${
                  approval.status === 'approved'
                    ? 'bg-green-50 text-green-700 border-green-200'
                    : approval.status === 'rejected'
                      ? 'bg-red-50 text-red-700 border-red-200'
                      : 'bg-yellow-50 text-yellow-700 border-yellow-200'
                }`}>
                  {approval.status ? approval.status.toUpperCase() : 'PENDING'}
                </span>
              </div>

              {selectedApproval !== approval._id && !approval.status && (
                <div className="flex justify-end">
                  <button
                    onClick={() => setSelectedApproval(approval._id)}
                    className="px-4 py-2 bg-primary text-white rounded-xl text-sm font-semibold transition-all duration-200 shadow-sm hover:bg-primary/90 cursor-pointer"
                  >
                    Review Request
                  </button>
                </div>
              )}

              {selectedApproval === approval._id && !approval.status && (
                <div className="mt-6 p-6 bg-gray-50 rounded-2xl border border-gray-100 transition-all duration-300">
                  <h4 className="text-sm font-heading font-bold text-slate-900 mb-4 uppercase tracking-wider">Review Details</h4>

                  {approval.milestoneDetails && (
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                      <div className="p-3 bg-white rounded-xl border border-gray-200">
                        <p className="text-xs font-medium text-secondary uppercase mb-1">Project</p>
                        <p className="text-sm font-semibold text-textMain">{approval.milestoneDetails.projectName}</p>
                      </div>
                      <div className="grid grid-cols-2 gap-4">
                        <div className="p-3 bg-white rounded-xl border border-gray-200">
                          <p className="text-xs font-medium text-secondary uppercase mb-1">Budget</p>
                          <p className="text-sm font-semibold text-textMain">{approval.milestoneDetails.budget}</p>
                        </div>
                        <div className="p-3 bg-white rounded-xl border border-gray-200">
                          <p className="text-xs font-medium text-secondary uppercase mb-1">Due Date</p>
                          <p className="text-sm font-semibold text-textMain">{approval.milestoneDetails.dueDate}</p>
                        </div>
                      </div>
                    </div>
                  )}

                  <div className="mb-6">
                    <label className="block text-xs font-bold text-secondary uppercase tracking-wider mb-2">
                      Approval Comments
                    </label>
                    <textarea
                      value={comment}
                      onChange={(e) => setComment(e.target.value)}
                      rows={3}
                      className="w-full rounded-xl border-gray-200 px-4 py-3 text-textMain focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
                      placeholder="Add your comments or feedback..."
                    />
                  </div>

                  <div className="flex space-x-3">
                    <button
                      onClick={() => handleApprove(approval._id, 'approved')}
                      className="flex-1 px-4 py-2 bg-green-600 text-white rounded-xl font-semibold transition-all duration-200 shadow-sm hover:bg-green-700 cursor-pointer"
                    >
                      Approve
                    </button>
                    <button
                      onClick={() => handleApprove(approval._id, 'rejected')}
                      className="flex-1 px-4 py-2 bg-red-600 text-white rounded-xl font-semibold transition-all duration-200 shadow-sm hover:bg-red-700 cursor-pointer"
                    >
                      Reject
                    </button>
                  </div>
                </div>
              )}

              {approval.comments && (
                <div className="mt-6 pt-6 border-t border-gray-100">
                  <div className="flex items-center gap-2 mb-2">
                    <span className="text-xs font-bold text-secondary uppercase tracking-wider">
                      {approval.status === 'approved' ? '✅ APPROVED' : '❌ REJECTED'}
                    </span>
                  </div>
                  <p className="text-sm text-gray-600 leading-relaxed">{approval.comments}</p>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

export default ApprovalsDashboard;
